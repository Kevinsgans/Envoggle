{
  "name": "envoggle",
  "version": "1.0.0",
  "scripts": {
    "test": "npm run build && node --test test/*.test.mjs",
    "build": "tsc && esbuild src/web.ts --bundle --platform=browser --outfile=dist/web.js",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "preview": "npm run build && node --env-file-if-exists=.env --watch scripts/preview.mjs",
    "agent": "node --env-file-if-exists=.env dist/agent.js start",
    "draft-dictionary": "node --env-file-if-exists=.env dist/draft-dictionary.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevinsgans/Envoggle.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/Kevinsgans/Envoggle/issues"
  },
  "homepage": "https://github.com/Kevinsgans/Envoggle#readme",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@livekit/agents": "1.10.0",
    "@livekit/agents-plugin-google": "^1.10.0",
    "@livekit/agents-plugin-openai": "1.10.0",
    "@livekit/rtc-node": "1.2.2",
    "livekit-client": "^2.24.0",
    "livekit-server-sdk": "^2.19.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}

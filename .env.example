# Shared server and agent settings
PORT=3000
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# The agent and server must use the same private key.
REFEREE_KEY=
ENVOGGLE_SERVER_URL=http://127.0.0.1:3000
AGENT_NAME=envoggle-referee
OPENAI_API_KEY=

# Fill with the actual, independently attributable track names on your Chert line.
# Use stable participant prefixes if the tracks have the same names.
CHERT_PLAYER_1_IDENTITY_PREFIX=
CHERT_PLAYER_1_AUDIO_TRACK=
CHERT_PLAYER_1_VIDEO_TRACK=
CHERT_PLAYER_2_IDENTITY_PREFIX=
CHERT_PLAYER_2_AUDIO_TRACK=
CHERT_PLAYER_2_VIDEO_TRACK=

# Leave blank to disable training-data retention.
TRAINING_DATA_DIR=
